# Admin password reset (used by: php artisan qiec:reset-admin-password)
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=

# Shared platform video streaming (YouTube Unlisted via OAuth — Super Admin Connect)
# Create a Google Cloud OAuth client (Web) with redirect:
#   {APP_URL}/v1/admin/system/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
# Optional: reuse Google login app keys if same project
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
