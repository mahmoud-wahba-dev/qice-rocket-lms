# Admin password reset (used by: php artisan qiec:reset-admin-password)
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=

# Public URL baked into certificate QR codes (phones cannot open *.local).
# Leave empty locally — code falls back to https://training.qiec.sa
# CERTIFICATE_PUBLIC_URL=https://training.qiec.sa

# Optional: path to ffmpeg for MP4 faststart after curriculum upload (seek-friendly streaming)
# FFMPEG_PATH=/usr/bin/ffmpeg
