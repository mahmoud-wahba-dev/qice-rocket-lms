# Admin password reset (used by: php artisan qiec:reset-admin-password)
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=

# Optional: path to ffmpeg for MP4 faststart after curriculum upload (seek-friendly streaming)
# FFMPEG_PATH=/usr/bin/ffmpeg

# Shared QIEC Google Drive for curriculum videos (works on local + production)
# Easiest: Admin → Settings → Google Drive → upload JSON + paste folder link
# Optional env fallbacks if you prefer .env instead of the admin UI:
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_DRIVE_CREDENTIALS=storage/app/google-drive/service-account.json
