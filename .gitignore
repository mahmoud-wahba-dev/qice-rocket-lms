# === SECURITY: Never commit these ===
/_backups/
/.env
/.env.testing
/.env.backup
/.env.production.bak
/firebase-auth.json
*.pem
*.sql
app/logs/*.log

# === Deploy scripts (contain server paths) ===
/deploy.ps1
/deploy.bat

# === Laravel standard ignores ===
/node_modules
/public/hot
/public/storage
/public/bin
/public/images
/public/debug_paytabs.log

# === Compiled public assets (re-generated by npm/artisan) — gitignored, يُعاد توليدها بـ mix/vite ===
/public/assets/**
!/public/assets/.htaccess
/public/vendor/**
/public/build/**
/public/mix-manifest.json

# === Uploaded user content (512M store) + ViewerJS — never commit ===
/public/store/**
!/public/store/.htaccess
/public/ViewerJS/**

# === Duplicate folder fix — نسخة مكررة 516M داخل resources (يجب حذفها) ===
/resources/public/
/resources/public/**

# === Large files exceeding GitHub 100MB limit ===
/database/regions/cities.json
/storage/*.key
/storage/framework/views
/storage/framework/laravel-excel
/vendor

# === IDE ===
/.idea
/.vscode

# === Build & cache ===
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
storage/debugbar/.gitignore

# === Misc ===
/build_output.txt
/.temp_backup_*
acc.txt

# === Archives / local dumps (never commit) — symlink in root points to Downloads ===
*.rar
*.7z
*.tar
*.tar.gz
*.zip
*.sql.gz
/public.rar
public.rar
